{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devnet-chat",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "devnet-api.clydeford.net",
      "custom_domain": true
    }
  ],
  "vars": {
    "MCP_URL": "https://devnet.cisco.com/v1/foundation-search-mcp/mcp",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  }
}
